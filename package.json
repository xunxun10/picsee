{
  "name": "picsee",
  "version": "1.0.3",
  "description": "轻量看图软件",
  "main": "main.js",
  "scripts": {
    "build:native": "node scripts/gen-jpeg-config.js && node-gyp configure -C native && node-gyp build -C native",
    "start": "npm run build:native && electron .",
    "dist": "npm run build:native && electron-builder --win --x64 --dir",
    "linux.x86": "npm run build:native && electron-builder --linux --x64 --dir",
    "arm": "npm run build:native && electron-builder --linux --arm64 --dir"
  },
  "author": "xunxun10",
  "license": "MIT",
  "build": {
    "appId": "com.xunxun10.picsee",
    "productName": "picsee",
    "npmRebuild": false,
    "files": [
      "!AGENTS.md",
      "!native/deps/**",
      "!native/src/**",
      "!native/binding.gyp",
      "!native/build/Release/obj/**",
      "!native/build/Release/*.lib",
      "!native/build/Release/*.exp",
      "!native/build/Release/*.pdb"
    ],
    "asarUnpack": [
      "native/build/Release/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "res/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "res/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "res/icon.ico",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "icon": "res/icon.png",
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.4.0",
    "node-addon-api": "^7.1.0",
    "node-gyp": "^9.4.0"
  },
  "dependencies": {
    "sharp": "0.32.6"
  }
}